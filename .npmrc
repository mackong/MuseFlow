# pnpm strict-mode hoist exceptions.
# eslint-plugin-tailwindcss → tailwind-api-utils does a dynamic
# `require('tailwindcss')`, which pnpm's strict node_modules layout hides
# from non-direct consumers. Hoisting tailwindcss to the top-level
# node_modules makes it resolvable.
public-hoist-pattern[]=tailwindcss
