# MuseFlow environment variables.
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. NEVER commit real secrets.
#
# All variables are server-only. None are prefixed with NEXT_PUBLIC_, so they
# are never bundled into client-side JavaScript (Constitution Principle VII +
# the user-stated rule: do not expose AI provider keys to client-side code).

# -----------------------------------------------------------------------------
# Database (Postgres) — REQUIRED
# -----------------------------------------------------------------------------
# Pooled connection string used by the runtime. For Neon, use the pooled
# endpoint with `?pgbouncer=true&connection_limit=1`.
DATABASE_URL="postgres://user:password@host:5432/museflow?pgbouncer=true&connection_limit=1"

# Direct (non-pooled) connection string used by `prisma migrate`. For Neon,
# this is the direct endpoint without the pooler suffix.
DIRECT_DATABASE_URL="postgres://user:password@host:5432/museflow"

# -----------------------------------------------------------------------------
# Auth.js — REQUIRED
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-base64-secret"

# Public URL of the app. Used by Auth.js for callback URLs.
AUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Auth.js Email Provider (magic link) — OPTIONAL
# -----------------------------------------------------------------------------
# If unset, the dev email transport prints magic links to the server console.
# Format: smtp://user:pass@host:port
EMAIL_SERVER=""
EMAIL_FROM="MuseFlow <noreply@museflow.local>"

# -----------------------------------------------------------------------------
# Auth.js GitHub OAuth — OPTIONAL
# -----------------------------------------------------------------------------
# Create a GitHub OAuth app at https://github.com/settings/developers
# Authorization callback URL: <AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# AI provider (OpenAI-compatible) — REQUIRED when MUSEFLOW_AI_PROVIDER=openai
# -----------------------------------------------------------------------------
OPENAI_API_KEY="sk-replace-me"

# Override the default OpenAI base URL to target any OpenAI-compatible
# endpoint (Together, OpenRouter, Groq, vLLM, Ollama, etc.). Leave empty for
# the official OpenAI API.
OPENAI_BASE_URL=""

# Cost-efficient general-purpose model recommended for the MVP.
OPENAI_MODEL="gpt-4o-mini"

# Moderation model used by the OpenAI moderator implementation.
OPENAI_MODERATION_MODEL="omni-moderation-latest"

# -----------------------------------------------------------------------------
# Rate limiting (Upstash Redis) — REQUIRED for AI generation
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# -----------------------------------------------------------------------------
# Provider selection — OPTIONAL (defaults shown)
# -----------------------------------------------------------------------------
# `openai` (default) targets the OpenAI-compatible API above.
# `fake`   uses an in-process fake provider for offline dev and tests; no
#          OPENAI_* values are required when this is set.
MUSEFLOW_AI_PROVIDER="openai"

# `openai` (default) calls the OpenAI Moderation API.
# `fake`   uses an in-process fake moderator that allows by default and
#          rejects only test-trigger phrases.
MUSEFLOW_MODERATOR="openai"
